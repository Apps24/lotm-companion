# Optional Phase 8 reader cloud sync.
# Use a Supabase project URL and a publishable key only. Never put service-role/secret keys in NEXT_PUBLIC_* values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional high-quality Cloudflare Workers AI narrator endpoint.
# Browser Natural narration works when this is blank.
NEXT_PUBLIC_TTS_WORKER_URL=
